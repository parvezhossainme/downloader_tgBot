{
  "name": "multi-downloader-vps",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"tsx watch src/index.ts\" \"tsx watch src/bot/bot.ts\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:bot": "tsx watch src/bot/bot.ts",
    "dev:all": "npm run dev",
    "start": "concurrently \"node dist/index.js\" \"node dist/bot/bot.js\"",
    "start:api": "node dist/index.js",
    "start:bot": "node dist/bot/bot.js",
    "start:all": "npm run start",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "concurrently": "^8.2.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "puppeteer": "^21.3.8",
    "telegraf": "^4.12.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.2",
    "rimraf": "^5.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
  
}
